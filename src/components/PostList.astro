---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const yearOf = (post: CollectionEntry<'blog'>) => post.data.pubDate.getFullYear();
const years = [...new Set(posts.map(yearOf))].sort((a, b) => b - a);
---

{
	years.map((year) => (
		<section class="year">
			<h2>{year}</h2>
			<ul>
				{posts.filter((post) => yearOf(post) === year).map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="title">{post.data.title}</span>
							<span class="date">
								<FormattedDate date={post.data.pubDate} format={{ month: 'short', day: 'numeric' }} />
							</span>
							<span class="description">{post.data.description}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	))
}

<style>
	.year {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 0 1.5rem;
		margin-bottom: 2rem;
	}
	h2 {
		margin: 0;
		padding-top: 0.15rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		margin: 0;
	}
	li + li {
		border-top: 1px solid var(--border);
	}
	a {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.15rem 1rem;
		padding: 0.15rem 0 1.1rem;
		color: inherit;
		text-decoration: none;
	}
	li + li a {
		padding-top: 1.1rem;
	}
	.title {
		font-weight: 600;
		line-height: 1.5;
		transition: color 0.15s;
	}
	a:hover .title {
		color: var(--accent);
	}
	.date {
		color: var(--text-muted);
		font-size: 0.85rem;
		white-space: nowrap;
		padding-top: 0.2rem;
		font-variant-numeric: tabular-nums;
	}
	.description {
		grid-column: 1 / -1;
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 720px) {
		.year {
			grid-template-columns: 1fr;
		}
		h2 {
			margin-bottom: 0.75rem;
		}
	}
</style>
