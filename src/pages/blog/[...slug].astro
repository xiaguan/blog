---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getSeries, getSortedPosts, type Post, postHref, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const series = getSeries(posts);
	const link = (post?: Post) => post && { title: post.data.title, href: postHref(post) };
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			newer: link(posts[i - 1]),
			older: link(posts[i + 1]),
			minutes: readingMinutes(post.body),
			seriesParts: series.find((s) => s.name === post.data.series?.name)?.parts ?? [],
		},
	}));
}

const { post, ...nav } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} {...nav}>
	<Content />
</BlogPost>
