---
import { Image } from 'astro:assets';
import afterHours from '../assets/after-hours.png';
import FormattedDate from '../components/FormattedDate.astro';
import Links from '../components/Links.astro';
import { SERIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
import { getSeries, getSortedPosts, type Post, postHref } from '../lib/posts';

const posts = await getSortedPosts();
const series = getSeries(posts);
const yearOf = (post: Post) => post.data.pubDate.getFullYear();
const years = [...new Set(posts.map(yearOf))];
const shortTitle = (title: string) => title.replace(/^[^:：]+[:：]\s*/, '');
const monthDay = { month: 'short', day: '2-digit' } as const;

const building = [
	{ name: 'kern', href: 'https://github.com/pegainfer-project/kern' },
	{ name: 'pegainfer', href: SERIES.pegainfer.repo },
	{ name: 'Pegaflow', href: SERIES.pegaflow.repo },
];
const contributing = [
	{ name: 'Mooncake', href: 'https://github.com/kvcache-ai/Mooncake' },
	{ name: 'vLLM', href: 'https://github.com/vllm-project/vllm' },
	{ name: 'SGLang', href: 'https://github.com/sgl-project/sglang' },
];
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} dusk>
	<div class="edition mono"><span>FIELD NOTES / JINYANG SU</span><span>SYSTEMS · INFERENCE · ENGINEERING</span></div>
	<section class="hero">
		<p class="eyebrow mono"><span></span> A quiet place to think, build & write.</p>
		<h1>Systems, inference,<br /><span>and the spaces between.</span></h1>
		<p class="byline mono">
			Jinyang Su — LLM inference engineer, ex-database storage.
			<br />
			Building <Links items={building} />. Contributing to <Links items={contributing} />.
		</p>
	</section>

	<figure class="landscape">
		<Image src={afterHours} widths={[640, 960, 1600, 1942]} sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 960px) calc(100vw - 64px), 864px" format="webp" quality={85} alt="蓝色暮光中的公路弯向远山，一个人在路旁散步，身后的小屋亮着暖黄色的灯。" loading="eager" fetchpriority="high" />
		<figcaption class="mono"><span>01 / AFTER HOURS</span><span lang="zh-CN">善弈者谋势。</span></figcaption>
	</figure>

	<section>
		<h2>Ongoing explorations <span class="section-note mono">/ SERIES</span></h2>
		<ul class="outline">
			{
				series.map((s) => (
					<li id={s.name}>
						<div class="row">
							<a href={s.repo} class="ref">{s.title}</a>
							<span class="muted">{s.description}</span>
						</div>
						<ul class="numbered">
							{s.parts.map((post) => (
								<li>
									<a href={postHref(post)} class="part">
										{shortTitle(post.data.title)}
									</a>
								</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</section>

	{
		years.map((year) => (
			<section>
				<h2 class="year">Writing <span class="section-note mono">/ {year}</span></h2>
				<ul class="outline">
					{posts
						.filter((post) => yearOf(post) === year)
						.map((post) => (
							<li>
								<div class="row">
									<a href={postHref(post)} class="ref">{post.data.title}</a>
									<span class="date mono">
										<FormattedDate date={post.data.pubDate} format={monthDay} />
									</span>
								</div>
								<p class="description">{post.data.description}</p>
							</li>
						))}
				</ul>
			</section>
		))
	}
</Page>

<style>
	.edition { display: flex; justify-content: space-between; gap: 1rem; font-size: .62rem; letter-spacing: .12em; color: var(--text-muted); border-bottom: 1px solid var(--border); padding-bottom: 1.25rem; }
	.hero { padding: 3.7rem 0 2.8rem; }
	.eyebrow { color: #b9b8aa; font-size: .72rem; margin-bottom: 1.6rem; }
	.eyebrow span { display: inline-block; width: 6px; height: 6px; margin: 0 .65rem 1px 0; background: #db9b6c; border-radius: 50%; }
	.hero h1 { margin: 0; font-size: clamp(2.2rem, 4.6vw, 4rem); font-weight: 450; line-height: 1.13; letter-spacing: -.05em; }
	.hero h1 span { color: #a3b4b4; }
	.byline { margin: 1.8rem 0 0; max-width: 78ch; color: var(--text-muted); line-height: 1.9; font-size: .74rem; }
	.landscape { margin: 0 0 4.5rem; }
	.landscape img { margin: 0; width: 100%; border-radius: 0; filter: none; }
	figcaption { display: flex; justify-content: space-between; gap: 1rem; margin-top: .85rem; font-size: .6rem; color: var(--text-muted); }
	h2 { margin: 3.4rem 0 1.6rem; font-size: 1.4rem; font-weight: 450; letter-spacing: -.03em; }
	.section-note { margin-left: .7rem; font-size: .65rem; letter-spacing: .08em; color: var(--text-muted); font-weight: 400; }
	.row { display: flex; align-items: baseline; gap: .25rem 1rem; flex-wrap: wrap; }
	.ref { color: var(--title); font-weight: 500; text-decoration: none; }
	.ref:hover, .part:hover { color: var(--blue); }
	.outline { list-style: none; }
	.outline > li { padding: 1.25rem 0; margin: 0; border-top: 1px solid var(--border); }
	.outline > li::before { display: none; }
	.date { margin-left: auto; color: var(--text-muted); font-size: .7rem; white-space: nowrap; }
	.muted, .description { color: var(--text-muted); font-size: .82rem; }
	.description { margin: .5rem 0 0; max-width: 74ch; line-height: 1.8; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.numbered { margin-top: .85rem !important; }
	.part { color: var(--text); text-decoration: none; font-size: .85rem; }
	.numbered li { margin-bottom: .35rem; }
	@media(max-width: 600px) {
		.edition > :last-child { display: none; }
		.hero { padding-top: 2.5rem; }
		.hero h1 { font-size: clamp(1.8rem, 6.8vw, 2.7rem); }
		figcaption > :last-child { display: none; }
		.landscape { margin-bottom: 3rem; }
		.landscape img { height: auto; }
		.date { margin-left: 0; }
		.row { column-gap: 1.5rem; }
	}
</style>
