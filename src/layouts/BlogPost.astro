---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import 'katex/dist/katex.min.css';
import FormattedDate from '../components/FormattedDate.astro';
import { SERIES } from '../consts';
import { isChinese, type Post, postHref } from '../lib/posts';
import Page from './Page.astro';

type Link = { title: string; href: string };

type Props = CollectionEntry<'blog'>['data'] & {
	pageType?: 'website' | 'article';
	newer?: Link;
	older?: Link;
	seriesParts?: Post[];
	minutes?: number;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	series,
	pageType = 'article',
	newer,
	older,
	seriesParts = [],
	minutes,
} = Astro.props;
const isArticle = pageType === 'article';
const socialImage = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;
const seriesInfo = series && SERIES[series.name];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Page
	lang={isChinese(title) ? 'zh-CN' : 'en'}
	title={title}
	description={description}
	type={pageType}
	pubDate={isArticle ? pubDate : undefined}
	updatedDate={isArticle ? updatedDate : undefined}
	image={socialImage}
>
	<article>
		<h1>{title}</h1>
		{
			isArticle && (
				<p class="meta mono">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span>
							updated <FormattedDate date={updatedDate} />
						</span>
					)}
					{minutes && <span>{minutes} min read</span>}
					{series && seriesInfo && (
						<a href={`/#${series.name}`}>
							{`${seriesInfo.title} ${pad(series.part)}/${pad(seriesParts.length)}`}
						</a>
					)}
				</p>
			)
		}
		{heroImage && <Image class="hero" src={heroImage} alt={title} />}
		<div class="prose">
			<slot />
		</div>
	</article>
	{
		seriesInfo && seriesParts.length > 1 && (
			<section class="references">
				<h2 class="mono">
					<a href={`/#${series!.name}`}>{seriesInfo.title}</a> · {seriesParts.length} parts
				</h2>
				<ol>
					{seriesParts.map((post) => (
						<li>
							{post.data.title === title ? (
								<span aria-current="page">{post.data.title}</span>
							) : (
								<a href={postHref(post)}>{post.data.title}</a>
							)}
						</li>
					))}
				</ol>
			</section>
		)
	}
	{
		(newer || older) && (
			<nav class="post-nav" aria-label="More posts">
				{older ? (
					<a href={older.href}>
						<span class="label mono">← older</span>
						<span class="title">{older.title}</span>
					</a>
				) : (
					<span />
				)}
				{newer && (
					<a href={newer.href} class="newer">
						<span class="label mono">newer →</span>
						<span class="title">{newer.title}</span>
					</a>
				)}
			</nav>
		)
	}
</Page>

<style>
	h1 {
		margin: 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		margin: 1.25rem 0 2.75rem;
		color: var(--text-muted);
	}
	.meta > :global(*:not(:first-child))::before {
		content: '/';
		margin: 0 0.6rem;
		color: var(--border);
	}
	.meta a {
		color: var(--blue);
		text-decoration: none;
	}
	.hero {
		margin: 0 0 2.75rem;
		width: 100%;
		border: 1px solid var(--border);
	}
	.prose > :global(:first-child) {
		margin-top: 0;
	}
	.references {
		margin-top: 4.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--title);
		font-size: 0.92rem;
	}
	.references h2 {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--text-muted);
	}
	.references h2 a {
		color: var(--title);
		text-decoration: none;
	}
	.references ol {
		margin: 0;
		padding-left: 1.6em;
	}
	.references li {
		margin: 0.2em 0;
	}
	.references li::marker {
		font-family: var(--font-mono);
		font-size: 0.85em;
	}
	.references a {
		color: var(--text);
		text-decoration: none;
	}
	.references a:hover {
		color: var(--blue);
	}
	[aria-current='page'] {
		color: var(--title);
		font-weight: 600;
		background: linear-gradient(transparent 58%, var(--marker) 58%, var(--marker) 92%, transparent 92%);
	}
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.post-nav a {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		color: inherit;
		text-decoration: none;
	}
	.post-nav .newer {
		text-align: right;
	}
	.label {
		color: var(--text-muted);
	}
	.post-nav .title {
		color: var(--title);
		font-weight: 600;
		line-height: 1.45;
		transition: color 0.15s;
	}
	.post-nav a:hover .title {
		color: var(--blue);
	}
	@media (max-width: 720px) {
		.post-nav {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
		.post-nav .newer {
			text-align: left;
		}
	}
</style>
