---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	pageType?: 'website' | 'article';
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	pageType = 'article',
} = Astro.props;
const socialImage = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;
---

<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			type={pageType}
			pubDate={pageType === 'article' ? pubDate : undefined}
			updatedDate={pageType === 'article' ? updatedDate : undefined}
			image={socialImage}
		/>
	</head>

	<body>
		<Header />
		<main>
			<article class="prose">
				<div class="post-header">
					<h1>{title}</h1>
					<div class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated">
									(updated <FormattedDate date={updatedDate} />)
								</span>
							)
						}
					</div>
					</div>
					{heroImage && <Image src={heroImage} alt={title} />}
					<hr />
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 0.5em;
	}
	.post-header h1 {
		margin: 0 0 0.3em 0;
	}
	.date {
		color: var(--text-light, #666);
		font-size: 0.9em;
	}
	.last-updated {
		font-style: italic;
	}
</style>
